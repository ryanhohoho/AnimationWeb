# Dependencies (regenerated by `npm install`)
node_modules/

# Build output (regenerated by `npm run build`)
dist/

# Large source media. The cloud clip is the ONLY copy of the sky's source —
# tools/bake_sky.mjs turns it into src/assets/media/sky-field.webp, which is
# what ships. Kept out of git for size, not because it is disposable.
assets-source/

# Generated by the tooling, never read by the app
/tools/_rig.npy
/motion_dump.json
/turn_dump.json
/pose_frames.json
tools/preview/

# OS / editor cruft
.DS_Store
Thumbs.db

# Python bytecode
__pycache__/
*.pyc

# ── reference material, not site code ────────────────────────────────────────
# aesthetic-images/ is the ~200-image taste board RYAN.txt was distilled from
# (52 MB); roy/ is a clone of the portfolio the deck's flow was studied from and
# carries its own .git. Both are inputs to decisions, not inputs to the build.
aesthetic-images/
roy/

# personal details. The resume is where content.js's copy came from and it
# carries a phone number and a home address; the site needs neither.
Ryan Resume.txt
