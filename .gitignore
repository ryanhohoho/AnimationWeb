# What is committed is exactly what `npm ci && npm run build` needs to produce
# the site, plus the tools, tests and docs that made it. Everything the build
# reads lives inside this folder: nothing is read from ../VisualAudialExperience
# or ../USB-UI at build time (their outputs are baked into src/ and committed).

# ── regenerated ──────────────────────────────────────────────────────────────
# dependencies (`npm ci` from package-lock.json)
node_modules/
# build output (`npm run build`; the host builds its own from source)
dist/

# ── local machine and hosting-tool files ─────────────────────────────────────
.DS_Store
Thumbs.db
*.log
npm-debug.log*
# `vercel` CLI project link (ids for this machine's login)
.vercel/
# secrets, if any are ever added (none are used today)
.env
.env.*
.recovery_codes
# personal agent permissions (.claude/launch.json IS shared: the preview configs)
.claude/settings.local.json
  
# Python bytecode (tools/*.py)
__pycache__/
*.pyc

# ── large source media ───────────────────────────────────────────────────────
# The cloud clip is the ONLY copy of the sky's source; tools/bake_sky.mjs turns
# it into src/assets/media/sky-field.webp, which is what ships. Kept out of git
# for size (60 MB), not because it is disposable -- back it up elsewhere.
assets-source/

# The photos card's originals, straight off the phone. They carry GPS
# positions and full resolution; tools/bake_photos.mjs writes the stripped,
# sized copies into src/assets/photos/, which is what ships.
photos-source/

# ── generated by the tooling, never read by the app ─────────────────────────
/tools/_rig.npy
/motion_dump.json
/turn_dump.json
/pose_frames.json
tools/preview/

# ── working files for the model, not inputs to the build ─────────────────────
# Blender scenes (the rig is rebuilt from mewNew.glb by tools/rig_mew.py), and
# the downloaded original model, which is third-party and not ours to publish
*.blend
*.blend1
tools/legacy/*.glb

# ── font downloads ───────────────────────────────────────────────────────────
# The site ships DarkerGrotesque-var.woff2 (+ OFL-DarkerGrotesque.txt). Kept:
# the variable TTF it was converted from, and its OFL/README. Not kept: the
# download zip (a duplicate of the folder) and the seven static weights.
src/assets/fonts/Darker_Grotesque.zip
src/assets/fonts/Darker_Grotesque/static/

# ── reference material, not site code ────────────────────────────────────────
# aesthetic-images/ is the ~200-image taste board RYAN.txt was distilled from
# (52 MB); roy/ is a clone of the portfolio the deck's flow was studied from
# (640 MB, 20k files, its own .git). Inputs to decisions, not to the build.
aesthetic-images/
roy/
# loose reference frames dropped in the root while working (the 3 MB
# surprised-face gif the squint was built from)
/*.gif

# ── personal details ─────────────────────────────────────────────────────────
# The resume is where content.js's copy came from and it carries a phone number
# and a home address; the site needs neither.
Ryan Resume.txt
