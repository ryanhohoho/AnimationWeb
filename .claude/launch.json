{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mew-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5273",
        "--strictPort"
      ],
      "port": 5273
    },
    {
      "name": "mew-dist",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--",
        "--port",
        "5274",
        "--strictPort"
      ],
      "port": 5274
    },
    {
      "name": "mew-edit",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "edit",
        "--",
        "--no-open"
      ],
      "port": 5275
    },
    {
      "name": "mew-edit-2",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "ED_STAGE=node_modules/.editor-staging-2",
        "npx",
        "vite",
        "--config",
        "editor/vite.editor.config.js",
        "--port",
        "5276",
        "--strictPort",
        "--no-open"
      ],
      "port": 5276
    }
  ]
}
